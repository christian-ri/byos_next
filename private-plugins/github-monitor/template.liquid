<div class="github-monitor">
  <div class="gh-header">
    <div class="gh-brand">
      <svg class="gh-brand-logo" viewBox="0 0 1024 1024" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z" transform="scale(64)" fill="#111"></path>
      </svg>
      <span>GitHub</span>
    </div>
    <div class="gh-clock">
      <div class="gh-clock-time">{{ meta.currentTime }}</div>
      <div class="gh-clock-label">{{ meta.updatedLabel }}</div>
    </div>
    <div class="gh-status gh-status-{% if status.level == "error" %}error{% elsif status.level == "warning" %}warning{% else %}ok{% endif %}">
      <div class="gh-status-dot"></div>
      <div>{{ status.label }}</div>
    </div>
  </div>

  <div class="gh-kpis">
    <div class="gh-card">
      <div class="gh-card-label">REPOS</div>
      <div class="gh-card-value">{{ metrics.repositories }}</div>
      <div class="gh-card-secondary">{{ meta.owner }}</div>
    </div>
    <div class="gh-card">
      <div class="gh-card-label">PRS</div>
      <div class="gh-card-value">{{ metrics.openPullRequests }}</div>
      <div class="gh-card-secondary">offen</div>
    </div>
    <div class="gh-card">
      <div class="gh-card-label">ISSUES</div>
      <div class="gh-card-value">{{ metrics.openIssues }}</div>
      <div class="gh-card-secondary">offen</div>
    </div>
    <div class="gh-card">
      <div class="gh-card-label">ACTIONS</div>
      <div class="gh-card-value">{% if metrics.actionsSuccessRate7d == blank %}n/a{% else %}{{ metrics.actionsSuccessRate7d }}%{% endif %}</div>
      <div class="gh-card-secondary">7 Tage</div>
    </div>
    <div class="gh-card">
      <div class="gh-card-label">SICHERHEIT</div>
      <div class="gh-card-value">{% if metrics.securityAlerts == blank %}n/a{% else %}{{ metrics.securityAlerts }}{% endif %}</div>
      <div class="gh-card-secondary">{% if metrics.criticalSecurityAlerts == blank %}n/a{% else %}{{ metrics.criticalSecurityAlerts }} kritisch{% endif %}</div>
    </div>
    <div class="gh-card">
      <div class="gh-card-label">LETZTER COMMIT</div>
      <div class="gh-card-value">{% if metrics.latestCommitAge == blank %}n/a{% else %}{{ metrics.latestCommitAge }}{% endif %}</div>
      <div class="gh-card-secondary">aktuell</div>
    </div>
  </div>

  <div class="gh-main">
    <div class="gh-panel gh-main-left">
      <div class="gh-panel-title">AKTUELLE WORKFLOWS</div>
      <div class="gh-table-head">
        <div class="gh-head-cell w-repo">Repo</div>
        <div class="gh-head-cell w-workflow">Workflow</div>
        <div class="gh-head-cell w-status">Status</div>
        <div class="gh-head-cell w-branch">Zweig</div>
        <div class="gh-head-cell w-duration">Dauer</div>
        <div class="gh-head-cell w-age">Alt</div>
      </div>
      {% for run in workflowRuns limit: 5 %}
      <div class="gh-table-row">
        <div class="w-repo gh-repo">{{ run.repository | truncate: 12 }}</div>
        <div class="w-workflow">{{ run.workflow | truncate: 12 }}</div>
        <div class="w-status">{{ run.status }}</div>
        <div class="w-branch">{{ run.branch }}</div>
        <div class="w-duration">{% if run.duration == blank %}n/a{% else %}{{ run.duration }}{% endif %}</div>
        <div class="w-age">{{ run.age }}</div>
      </div>
      {% endfor %}
    </div>

    <div class="gh-panel gh-main-right">
      <div class="gh-panel-title">REPO HEALTH</div>
      <div class="gh-table-head">
        <div class="gh-head-cell w-health-repo">Repo</div>
        <div class="gh-head-cell w-health-small">PR</div>
        <div class="gh-head-cell w-health-issues">Iss</div>
        <div class="gh-head-cell w-health-last">Last</div>
        <div class="gh-head-cell w-health-status">Stat</div>
      </div>
      {% for repo in repositoryHealth limit: 6 %}
      <div class="gh-table-row">
        <div class="w-health-repo gh-repo">{{ repo.repository | truncate: 12 }}</div>
        <div class="w-health-small">{{ repo.openPullRequests }}</div>
        <div class="w-health-issues">{{ repo.openIssues }}</div>
        <div class="w-health-last">{% if repo.latestCommitAge == blank %}n/a{% else %}{{ repo.latestCommitAge }}{% endif %}</div>
        <div class="w-health-status">{{ repo.status }}</div>
      </div>
      {% endfor %}
    </div>
  </div>

  <div class="gh-footer">
    <div class="gh-footer-card">
      <div class="gh-footer-label">AKTIVE BRANCHES</div>
      <div class="gh-footer-value">{% if footer.activeBranches == blank %}n/a{% else %}{{ footer.activeBranches }}{% endif %}</div>
      <div class="gh-footer-secondary">gesamt</div>
    </div>
    <div class="gh-footer-card">
      <div class="gh-footer-label">RELEASES</div>
      <div class="gh-footer-value">{{ footer.releases30d }}</div>
      <div class="gh-footer-secondary">{% if footer.latestRelease == blank %}n/a{% else %}{{ footer.latestRelease | split: " " | last | truncate: 12 }}{% endif %}</div>
    </div>
    <div class="gh-footer-card">
      <div class="gh-footer-label">MITARBEITER</div>
      <div class="gh-footer-value">{% if footer.contributors == blank %}n/a{% else %}{{ footer.contributors }}{% endif %}</div>
      <div class="gh-footer-secondary">{{ meta.owner }}</div>
    </div>
    <div class="gh-footer-card">
      <div class="gh-footer-label">COMMITS</div>
      <div class="gh-footer-value">{% if footer.commits7d == blank %}n/a{% else %}{{ footer.commits7d }}{% endif %}</div>
      <div class="gh-footer-secondary">7 Tage</div>
    </div>
    <div class="gh-footer-card">
      <div class="gh-footer-label">SECRETS</div>
      <div class="gh-footer-value">{% if footer.secretScanningAlerts == blank %}n/a{% else %}{{ footer.secretScanningAlerts }}{% endif %}</div>
      <div class="gh-footer-secondary">{{ status.label }}</div>
    </div>
  </div>
</div>
